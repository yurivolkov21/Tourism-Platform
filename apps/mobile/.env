# API origin (no /api/v1 suffix — the client adds route paths).
# LAN debugging: point at your PC, e.g. http://192.168.1.20:3000 (phone + PC on the same Wi-Fi).
# Fallback only — a real Metro session always derives the current LAN IP
# instead (see .env.example) and ignores this. Needed as-is for jest/CI, which
# have no dev server to derive from.
# ⚠️ 2026-08-20: that host currently serves the API under `/api`, while the
# generated client calls `/api/v1/*` — every request 404s until Render's
# `API_PREFIX` is set back to `api/v1` (see docs/05-runbooks/env-and-secrets.md).
EXPO_PUBLIC_API_BASE_URL=https://api.nexora-travel.agency
# Supabase project (same values the web browser bundle ships — public by design).
EXPO_PUBLIC_SUPABASE_URL=https://hvkyrjlhsioptznuadxw.supabase.co
# Deployed web origin — the Account tab opens /privacy and /terms there.
EXPO_PUBLIC_WEB_URL=https://www.nexora-travel.agency
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh2a3lyamxoc2lvcHR6bnVhZHh3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA0ODY4MzksImV4cCI6MjA5NjA2MjgzOX0.D8GenM_3dD7uXE7eMzizrHihPEZ4FWd0moA0H2QK3-c
