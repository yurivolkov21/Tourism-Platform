# API origin (no /api/v1 suffix — the client adds route paths).
# LAN debugging: point at your PC, e.g. http://192.168.1.20:3000 (phone + PC on the same Wi-Fi).
# Fallback only — a real Metro session always derives the current LAN IP
# instead (see .env.example) and ignores this. Needed as-is for jest/CI, which
# have no dev server to derive from.
EXPO_PUBLIC_API_BASE_URL=https://tourism-api-pqwr.onrender.com
# Supabase project (same values the web browser bundle ships — public by design).
EXPO_PUBLIC_SUPABASE_URL=https://hvkyrjlhsioptznuadxw.supabase.co
# Deployed web origin — the Account tab opens /privacy and /terms there.
EXPO_PUBLIC_WEB_URL=https://tourism-platform-web.vercel.app
